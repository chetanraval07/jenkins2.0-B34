
pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git 'https://github.com/chetanraval07/jenkins2.0-B34.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'java -version'
                    sh 'mvn -version'
                    sh 'mvn clean package -DskipTests'
                }

                echo 'BUILD-SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'sonarqube',
                    credentialsId: 'sonar-cred'
                ) {
                    dir('backend') {
                        sh '''mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
  -Dsonar.projectKey=test-project \
  -Dsonar.projectName='test-project'
'''
                    }
                }

                echo 'TEST-SUCCESS'
            }
        }
        
        
        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: true, credentialsId: 'sonar-cred'
                echo 'QUALITY-PASSED'
                }

                echo 'QUALITY-PASSED'                 
	    }    
        }
        stage('STORE-ARTIFACT') {
            steps {
                sh '''
aws s3 cp backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar \
s3://my-jenkins-bucxx-b34/student-app.jar
'''
            }
        }
        stage ('RELEASE-PROCCESS') {
	   steps {
	       timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Approval is required. Shall we proceed?, OK : "Approve"'
	   
	       }
	   }
	 }
    }
}

